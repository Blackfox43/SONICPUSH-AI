rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Default deny all public and unauthenticated storage access
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Private organization-scoped audio assets:
    // All uploads, updates, and deletions are executed exclusively by the server-side Firebase Admin SDK.
    // Direct client writes/deletes are unconditionally denied and client-supplied metadata is never trusted.
    match /organizations/{orgId}/audio/{fileName} {
      allow read: if request.auth != null &&
                     request.auth.token.email_verified == true &&
                     orgId.matches('^[a-zA-Z0-9_\\-]+$') &&
                     fileName.matches('^[a-zA-Z0-9._\\-]+$') &&
                     (
                       request.auth.token.superAdmin == true ||
                       request.auth.token.role == 'SUPER_ADMIN' ||
                       request.auth.token.email == 'emma432cent@gmail.com' ||
                       (
                         request.auth.token.organizationId is string &&
                         request.auth.token.organizationId == orgId
                       )
                     );

      allow create, update, delete: if false;
    }
  }
}
