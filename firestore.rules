      allow create: if isVerified() && isValidId(orgId) && isValidOrganization(incoming()) &&
                       incoming().id == orgId &&
                       incoming().ownerId == request.auth.uid &&
                       isValidAssignedUsers(incoming().assignedUserIds) &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(orgId) && isValidOrganization(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time &&
                       existing().ownerId in incoming().assignedUserIds && (
                         isSuperAdmin() ||
                         (existing().ownerId == request.auth.uid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'type', 'country', 'defaultCurrency', 'assignedUserIds', 'updatedAt']))
