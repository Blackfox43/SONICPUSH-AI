    match /audio_cleanup_logs/{logId} {
      allow get: if isSuperAdmin() && isValidId(logId);
      allow list: if isVerified() && hasAdminListAccess();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /audio_cleanup_queue/{itemId} {
      allow get: if isSuperAdmin() && isValidId(itemId);
      allow list: if isVerified() && hasAdminListAccess();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /audio_cleanup_cursors/{cursorId} {
      allow get: if isSuperAdmin() && isValidId(cursorId);
      allow list: if isVerified() && hasAdminListAccess();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}
