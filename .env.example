# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT=3000

# Firebase Admin SDK / GCP Project Overrides (optional; defaults read from firebase-applet-config.json)
# On Google Cloud Run, attach a Service Account with ADC (roles/datastore.user, roles/storage.objectAdmin, roles/firebaseauth.admin).
FIREBASE_PROJECT_ID=""
FIRESTORE_DATABASE_ID=""
FIREBASE_STORAGE_BUCKET=""

# Server-Only Bootstrap Super Admin Allowlist (comma-separated emails)
BOOTSTRAP_ADMIN_EMAILS="emma432cent@gmail.com"

# Distributed Firestore AI Rate Limiting & Quotas
AI_RATE_LIMIT_PER_MIN=15
AI_DAILY_QUOTA_PER_USER=150
AI_ORG_DAILY_QUOTA=600
AI_LIMIT_SONG_INTELLIGENCE_DAILY=40
AI_LIMIT_CAMPAIGN_DAILY=50
AI_LIMIT_CONTENT_DAILY=60
AI_LIMIT_TRENDS_DAILY=60
AI_LIMIT_OUTREACH_DAILY=80
AI_LIMIT_ASSISTANT_DAILY=120
ALLOW_STARTER_TIER_LIMITER_FALLBACK="true"

# Private Firebase Storage Audio Retention & Scheduled Cleanup
AUDIO_RETENTION_DAYS=90
AUDIO_CLEANUP_INTERVAL_MS=21600000
AUDIO_CLEANUP_CRON_SECRET=""
DISABLE_AUDIO_CLEANUP_SCHEDULER="false"

# Payment Gateway Server-Side Secrets (awaiting live merchant activation)
PAYSTACK_SECRET_KEY=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_SECRET_HASH=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYMENT_ATTESTATION_SECRET=""
